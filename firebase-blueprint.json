{
  "entities": {
    "AppUser": {
      "title": "AppUser",
      "description": "Akun pengguna aplikasi Lapak Pisang Sumber Sewu dengan kredensial tersimpan aman dan peran (owner/kasir).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik pengguna sekaligus username login (contoh: 252500).",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Username / ID pengguna untuk login.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Nama lengkap pengguna.",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["owner", "kasir"],
          "description": "Peran akses pengguna: owner (superadmin) atau kasir."
        },
        "passwordHash": {
          "type": "string",
          "description": "Hash SHA-256 ter-salt dari kata sandi pengguna.",
          "minLength": 64,
          "maxLength": 128
        },
        "salt": {
          "type": "string",
          "description": "Salt acak per pengguna untuk hashing kata sandi.",
          "minLength": 8,
          "maxLength": 64
        },
        "isActive": {
          "type": "boolean",
          "description": "Status aktif akun pengguna."
        },
        "createdById": {
          "type": "string",
          "description": "ID pengguna owner yang membuat akun ini.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAtDate": {
          "type": "string",
          "format": "date-time",
          "description": "Tanggal pembuatan akun (ISO string).",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pembuatan dokumen."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pembaruan dokumen."
        }
      },
      "required": [
        "id",
        "username",
        "fullName",
        "role",
        "passwordHash",
        "salt",
        "isActive",
        "createdAtDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "LapakWorkspace": {
      "title": "LapakWorkspace",
      "description": "Dokumen induk gudang Lapak Pisang Sumber Sewu untuk menyatukan seluruh transaksi operasional.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID ruang kerja gudang.",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Nama lapak / gudang.",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pembuatan dokumen."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pembaruan dokumen."
        }
      },
      "required": ["id", "name", "createdAt", "updatedAt"]
    },
    "BananaPurchase": {
      "title": "BananaPurchase",
      "description": "Nota pembelian pisang mentah dari petani (mendukung multi-varietas dalam satu nota timbangan).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID dokumen pembelian.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lapakId": {
          "type": "string",
          "description": "ID ruang kerja lapak induk.",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdById": {
          "type": "string",
          "description": "ID pengguna yang mencatat transaksi.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "description": "Nama lengkap petugas timbangan.",
          "maxLength": 120
        },
        "receiptNumber": {
          "type": "string",
          "description": "Nomor nota pembelian pisang.",
          "minLength": 1,
          "maxLength": 64
        },
        "farmerName": {
          "type": "string",
          "description": "Nama petani penjual pisang.",
          "minLength": 1,
          "maxLength": 150
        },
        "bananaType": {
          "type": "string",
          "description": "Varietas pisang utama atau ringkasan daftar varietas.",
          "minLength": 1,
          "maxLength": 200
        },
        "items": {
          "type": "array",
          "description": "Daftar rincian timbangan per jenis pisang (1-30 item)."
        },
        "bunches": {
          "type": "number",
          "description": "Total jumlah tandan."
        },
        "weightKg": {
          "type": "number",
          "description": "Total berat bersih pisang (kg)."
        },
        "buyPricePerKg": {
          "type": "number",
          "description": "Harga beli rata-rata tertimbang per kg."
        },
        "totalPayment": {
          "type": "number",
          "description": "Total pembayaran ke petani."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Tanggal transaksi pembelian (ISO string).",
          "maxLength": 64
        },
        "notes": {
          "type": "string",
          "description": "Catatan kondisi buah opsional.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pembuatan dokumen."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pembaruan dokumen."
        }
      },
      "required": [
        "id",
        "lapakId",
        "createdById",
        "receiptNumber",
        "farmerName",
        "bananaType",
        "items",
        "bunches",
        "weightKg",
        "buyPricePerKg",
        "totalPayment",
        "date",
        "createdAt",
        "updatedAt"
      ]
    },
    "BananaStockAdjustment": {
      "title": "BananaStockAdjustment",
      "description": "Catatan penyesuaian stok gudang atau reject/penyusutan buah pisang per varietas.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lapakId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdById": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "maxLength": 120
        },
        "adjustmentNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "bananaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "enum": ["PENAMBAHAN", "PENGURANGAN", "REJECT_BUSUK"]
        },
        "bunchesDelta": {
          "type": "number"
        },
        "weightDeltaKg": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "lapakId",
        "createdById",
        "adjustmentNumber",
        "bananaType",
        "type",
        "bunchesDelta",
        "weightDeltaKg",
        "reason",
        "date",
        "createdAt",
        "updatedAt"
      ]
    },
    "WarehouseSale": {
      "title": "WarehouseSale",
      "description": "Faktur penjualan pisang mentah per varietas ke gudang pusat dengan kalkulasi laba bersih dan status piutang.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lapakId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdById": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "maxLength": 120
        },
        "invoiceNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "buyerWarehouseName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "buyerWhatsApp": {
          "type": "string",
          "maxLength": 40
        },
        "buyerPhone": {
          "type": "string",
          "maxLength": 40
        },
        "bananaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "bunches": {
          "type": "number"
        },
        "weightKg": {
          "type": "number"
        },
        "costPricePerKg": {
          "type": "number"
        },
        "sellPricePerKg": {
          "type": "number"
        },
        "totalRevenue": {
          "type": "number"
        },
        "estimatedCost": {
          "type": "number"
        },
        "netProfit": {
          "type": "number"
        },
        "profitMarginPercent": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["LUNAS", "BELUM_LUNAS"]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Transfer Bank", "Tunai Langsung", "Transfer Susulan (Piutang)"]
        },
        "dueDate": {
          "type": "string",
          "maxLength": 32
        },
        "paidAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "lapakId",
        "createdById",
        "invoiceNumber",
        "buyerWarehouseName",
        "bananaType",
        "bunches",
        "weightKg",
        "costPricePerKg",
        "sellPricePerKg",
        "totalRevenue",
        "estimatedCost",
        "netProfit",
        "profitMarginPercent",
        "date",
        "paymentStatus",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/app_users/{userId}": {
      "schema": {
        "$ref": "#/entities/AppUser"
      },
      "description": "Koleksi akun pengguna aplikasi (owner/superadmin dan kasir)."
    },
    "/lapak/{lapakId}": {
      "schema": {
        "$ref": "#/entities/LapakWorkspace"
      },
      "description": "Dokumen induk gudang Lapak Pisang Sumber Sewu."
    },
    "/lapak/{lapakId}/purchases/{purchaseId}": {
      "schema": {
        "$ref": "#/entities/BananaPurchase"
      },
      "description": "Koleksi transaksi pembelian pisang dari petani."
    },
    "/lapak/{lapakId}/stock_adjustments/{adjustmentId}": {
      "schema": {
        "$ref": "#/entities/BananaStockAdjustment"
      },
      "description": "Koleksi penyesuaian stok & reject/penyusutan buah pisang."
    },
    "/lapak/{lapakId}/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/WarehouseSale"
      },
      "description": "Koleksi transaksi penjualan pisang ke gudang pusat."
    }
  }
}
